# ─────────────────────────────────────────────────────────────────────────────
# Otto server — environment configuration
# Copy this file to .env (`cp .env.example .env`) and fill it in. See SETUP.md for
# the step-by-step walkthrough.
#
# Only FIREBASE_SERVICE_ACCOUNT is strictly REQUIRED. Every other capability is
# feature-gated on its own vars: the agent needs OPENAI_API_KEY, WhatsApp needs
# all four META_* vars, Google needs both GOOGLE_* vars. The server logs which
# features are enabled at boot ("Otto server up { features: { ... } }").
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
PORT=3000                              # HTTP port to listen on (default 3000)
PUBLIC_ORIGIN=http://localhost:3000    # Your public https origin; builds the Google OAuth redirect + shown in logs
DATABASE_PATH=./data/otto.sqlite       # SQLite file, auto-created on boot (in Docker this is /data/otto.sqlite)
DEFAULT_TIMEZONE=Europe/London         # Fallback IANA zone — the app reports the phone's real zone on register/heartbeat (default UTC)
LOG_LEVEL=info                         # pino level: trace | debug | info | warn | error

# ── Firebase Cloud Messaging (REQUIRED) ──────────────────────────────────────
# The whole point of the server: push alarms to the phone. Must be the SAME Firebase
# project you registered the Android app in — the one its google-services.json came
# from, package com.otto.app. Different project = pushes that never arrive.
# Set this to the PATH of the downloaded service-account JSON file,
# OR paste the raw JSON inline (a value starting with "{" is treated as inline JSON).
FIREBASE_SERVICE_ACCOUNT=./service-account.json

# ── OpenAI agent (OPTIONAL — REST endpoints + FCM work without it) ───────────
# Enables the WhatsApp → AI → alarm brain. Create a key at https://platform.openai.com/api-keys
# NOTE: this is NOT the STT_API_KEY below, which points at an OpenAI-COMPATIBLE Groq endpoint.
OPENAI_API_KEY=                        # sk-...      (leave blank to disable the agent)
OPENAI_MODEL=gpt-5.6-luna              # default gpt-5.6-luna

# ── WhatsApp Cloud API (OPTIONAL — set ALL FOUR to enable the inbound webhook) ─
# See SETUP.md §7. If any one is missing, the /whatsapp/webhook route is not mounted.
META_APP_SECRET=                       # Meta app secret — verifies X-Hub-Signature-256 on inbound POSTs
META_VERIFY_TOKEN=                     # Any secret string you invent; must match the webhook "Verify token"
META_WA_PHONE_NUMBER_ID=               # Phone number ID from WhatsApp → API Setup
META_WA_ACCESS_TOKEN=                  # Permanent System-User token (whatsapp_business_messaging + _management)
# Owner allowlist: comma-separated WhatsApp numbers allowed to control the device (any format,
# compared digits-only). RECOMMENDED. If unset, the first number to message the server is trusted
# and all others are rejected — set this to lock it to your number(s).
OWNER_WA_NUMBERS=                      # e.g. +447700900000,+447700900001

# ── WhatsApp message template (OPTIONAL — needs the four META_* vars above) ───
# Meta only allows free-form text inside the 24h customer-service window. An APPROVED
# template is the one legal way to speak first after it shuts (and it can only re-open
# the window — it cannot carry arbitrary text). Create + get it approved under
# WhatsApp Manager → Message templates. Leaving NAME blank keeps templates off, and
# anything Otto wants to say while the window is shut simply stays queued in the outbox.
META_TEMPLATE_NAME=                    # Approved template name, e.g. otto_checkin (blank = disabled)
META_TEMPLATE_LANG=en                  # Template language code as approved, e.g. en / en_GB (default en)

# ── Google Calendar / Tasks (OPTIONAL — set BOTH to enable) ───────────────────
# See SETUP.md §9. The redirect URI is derived as ${PUBLIC_ORIGIN}/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=                # OAuth 2.0 "Web application" client ID
GOOGLE_OAUTH_CLIENT_SECRET=            # OAuth 2.0 "Web application" client secret

# ── Voice notes / speech-to-text (OPTIONAL — set the KEY to enable) ───────────
# Lets Otto understand WhatsApp voice notes instead of replying "I can only read text".
# Any OpenAI-compatible /audio/transcriptions endpoint works; the default base URL is
# Groq, which is fast and cheap for Whisper. Leave the key blank to disable.
STT_API_KEY=                           # e.g. gsk_...  (blank = voice notes stay unsupported)
STT_BASE_URL=https://api.groq.com/openai/v1   # OpenAI-compatible base URL (default shown)
STT_MODEL=whisper-large-v3-turbo       # Transcription model (default shown)

# ── Google Maps (OPTIONAL — travel time, and turning place names into addresses) ──
# ONE key, TWO APIs, and BOTH must be enabled on it in the same Google Cloud project:
#   Routes API        — real, traffic-aware travel time for leave-by alarms and journeys
#   Places API (New)  — resolving "the gym" or "the dentist" to an actual address
# Enabling only Routes is the trap: travel time works, place lookup returns nothing, and
# Otto has to ask for an address every time. Restrict the key to those two APIs.
#
# Without the key at all, leave-by alarms fall back to the per-device DEFAULT_TRAVEL_MINUTES
# setting instead of a real estimate, and Otto asks for addresses rather than searching.
GOOGLE_MAPS_API_KEY=                   # blank = flat travel-time fallback, no place lookup

# ── Scheduling defaults (OPTIONAL — per-device settings override these) ───────
# Server-wide fallbacks for the device_settings columns. Both are LOCAL wall-clock times
# in the device's own timezone, never a UTC offset. Both are validated AT BOOT: a typo
# fails the process immediately rather than silently disabling the feature at 3am.
QUIET_HOURS_DEFAULT=22:00-07:00        # "HH:MM-HH:MM" (may span midnight) or "off" (default 22:00-07:00)
WEEKLY_REVIEW_DEFAULT=SUN:18:00        # "DDD:HH:MM" — MON..SUN — or "off" (default SUN:18:00)

# ── Admin (REQUIRED unless PUBLIC_ORIGIN is localhost) ────────────────────────
# Protects /admin/* (device pairing secrets + test-alarm/sync/ping). The server REFUSES
# TO BOOT when PUBLIC_ORIGIN is not localhost and this is unset; on localhost it may stay
# empty (open, with a boot warning). Sent by clients as the `x-admin-token` request header.
ADMIN_TOKEN=                           # e.g. a long random string: `openssl rand -hex 24`
