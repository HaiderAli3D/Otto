# Copy to `keystore.properties` (gitignored) to sign the release APK with your own key.
# Generate a keystore once and back it up somewhere safe — losing it means you can't ship
# an update with the same app identity:
#
#   keytool -genkeypair -v -keystore otto-release.jks -alias otto \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Without this file, `assembleRelease` falls back to the debug key (installable for testing).
storeFile=otto-release.jks
storePassword=CHANGE_ME
keyAlias=otto
keyPassword=CHANGE_ME
