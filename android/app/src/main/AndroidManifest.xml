<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Foreground service backing the ring (mediaPlayback type: it plays alarm audio) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!--
      Location, ON DEMAND ONLY. Otto is ASKED where the owner is (REQUEST_LOCATION) and answers
      once; no update stream is ever registered and no coordinate is ever written to Room.

      ACCESS_BACKGROUND_LOCATION is not optional paranoia here, it is the precondition. There are
      TWO independent gates and a high-priority FCM message only opens one of them. It IS an
      exemption to the background foreground-service START restriction (API 31+), but it is NOT on
      the while-in-use exemption list (API 34+) — so a location-typed foreground service started
      while the app is backgrounded throws SecurityException without background location. A push
      arriving with the screen off is exactly the case this feature exists for.

      Sideloaded to the owner's phone only, so Play's restricted-permission policy does not apply;
      the constraint is reliability. Still opt-in: these are runtime permissions and nothing here
      works until the owner grants them, and every other feature works while they are denied.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Exact alarms: USE_EXACT_ALARM is auto-granted to genuine alarm apps on API 33+;
         SCHEDULE_EXACT_ALARM is only needed (and pre-granted) on API 31-32. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <application
        android:name=".OttoApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Otto"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <!-- Control panel / launcher -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Otto">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings / pairing screen -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Otto" />

        <!-- Full-screen ring screen, shown over the lockscreen -->
        <activity
            android:name=".ring.RingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Otto"
            android:turnScreenOn="true" />

        <!-- Foreground service that backs the ring so the sound outlives the Activity -->
        <service
            android:name=".ring.RingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
          Short-lived foreground service that holds the process open for exactly one location fix.
          Typed `location` because API 34+ checks the declared type against the held permissions at
          startForeground() time. Never started unless ACCESS_BACKGROUND_LOCATION is held AND the
          push actually arrived at high priority — see LocationDispatcher.
        -->
        <service
            android:name=".location.LocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- FCM: high-priority data messages -->
        <service
            android:name=".push.OttoFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Quick-settings tile: shows the next armed alarm -->
        <service
            android:name=".tile.NextAlarmTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_alarm"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Alarm fire receiver -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <!-- Buttons pressed on a nudge notification, and the swipe-away delete intent.
             A broadcast rather than an Activity so the owner can resolve a nudge from the
             lockscreen without unlocking; not exported, so only our own PendingIntents reach it. -->
        <receiver
            android:name=".nudge.NudgeActionReceiver"
            android:exported="false" />

        <!-- Re-show for a locally snoozed nudge. Its own receiver and its own intent action, so a
             nudge registration can never match an alarm's PendingIntent. -->
        <receiver
            android:name=".nudge.NudgeAlarmReceiver"
            android:exported="false" />

        <!-- Re-arm after reboot / app update -->
        <receiver
            android:name=".boot.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Re-validate armed alarms when the clock or timezone changes -->
        <receiver
            android:name=".alarm.TimeChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Hilt + WorkManager: disable WorkManager's default on-demand initializer so
             our HiltWorkerFactory (via OttoApp : Configuration.Provider) is used. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>
</manifest>
